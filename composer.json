{
  "name": "thewebsolver/payment-card",
  "description": "PHP library to validate Payment Cards (Debit/Credit and more)",
  "type": "library",
  "keywords": [
    "card-validation",
    "validator",
    "validation",
    "payment-card",
    "credit-card",
    "credit-card-validation",
    "bank-card"
  ],
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Shesh Ghimire",
      "email": "sheshgh@outlook.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "TheWebSolver\\Codegarage\\PaymentCard\\": "Src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TheWebSolver\\Codegarage\\Test\\": "Tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "thewebsolver/scraper": "dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.11",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "suggest": {
    "thewebsolver/luhn-algorithm": "Allows payment card validation against Luhn Algorithm",
    "thewebsolver/payment-card-cli": "Helps scraping, tracing and caching traced content via CLI"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "unittest": "vendor/bin/phpunit",
    "analyze": "vendor/bin/phpstan",
    "sniff": "vendor/bin/phpcs",
    "test": [
      "@analyze",
      "@unittest",
      "@sniff"
    ],
    "useDev": "@putenv COMPOSER=composer.dev.json",
    "update:dev": [
      "@useDev",
      "@composer update:packages"
    ],
    "test:dev": [
      "@useDev",
      "@composer test"
    ]
  }
}
