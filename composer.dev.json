{
  "minimum-stability":"dev",
  "prefer-stable": true,
  "scripts": {
    "useProd": "@putenv COMPOSER=composer.json",
    "update:packages": [
      "@composer update --prefer-source",
      "@useProd",
      "@composer dump-autoload -o"
    ],
    "test": ["phpstan", "phpunit"]
  },
  "require": {
    "php": ">=8.2",
    "thewebsolver/scraper": "dev-main"
  },
  "require-dev": {
    "thewebsolver/payment-card-cli": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../scraper"
    },
    {
      "type": "path",
      "url": "../cli"
    },
    {
      "type": "path",
      "url": "../cli-packages/payment-card-cli"
    }
  ]
}
