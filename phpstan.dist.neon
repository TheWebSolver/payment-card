includes:
	- vendor/thewebsolver/scraper/phpstan-common.neon
parameters:
	level: max
	paths:
		- Src/
		- Tests/
	ignoreErrors:
		-
			identifier: method.nonObject
			path: Tests/PaymentCardFactoryTest.php
		- # Card creation. Error catch.
			identifier: argument.type
			path: Src/PaymentCardFactory.php
			count: 8
		- # Card creation. Error catch.
			identifier: offsetAccess.nonOffsetAccessible
			path: Src/PaymentCardFactory.php
			count: 6
		- # Card creation. Error catch.
			identifier: argument.unpackNonIterable
			path: Src/PaymentCardFactory.php
			count: 2
		- # Always returns array of non-empty-list of resolved cards when exit on resolve is false.
			identifier: return.type
			messages:
				- '#^Method .*?resolve\(\) should return non-empty-array.*?$#'
				- '#^Method .*?resolve\(\) should return non-empty-list.*?$#'
				- '#^Method .*?resolveUsing\(\) should return non-empty-list.*?$#'
		- # Regex validated array instead of mixed.
			path: Src/Tracer/BraintreePaymentCardTracer.php
			identifier: return.type
			count: 1
		- # Allow Mocked Card Type in test files.
			identifier: argument.type
			messages:
			- '#^Parameter \#5 \$current of class.*?CardResolved constructor.*?$#'
