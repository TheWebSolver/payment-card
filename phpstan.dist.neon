includes:
	- vendor/thewebsolver/scraper/phpstan-common.neon
parameters:
	level: max
	paths:
		- Src/
		- Tests/QueueBasedFormatterTest.php
		- Tests/CustomValidatorTest.php
	ignoreErrors:
		-
			identifier: method.nonObject
			path: Tests/CardFactoryTest.php
		-
			identifier: return.type
			path: Src/PaymentCard.php
			message: '|fromFactory\(\) should return|'
			count: 1
		- # Card creation. Error catch.
			identifier: argument.type
			path: Src/CardFactory.php
			count: 8
		- # Card creation. Error catch.
			identifier: offsetAccess.nonOffsetAccessible
			path: Src/CardFactory.php
			count: 6
		- # Card creation. Error catch.
			identifier: argument.unpackNonIterable
			path: Src/CardFactory.php
			count: 2

